rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'roderek.young@gmail.com' && request.auth.token.email_verified == true;
    }
    match /uploads/{file} {
      allow read: if true;
      allow write: if isTeacher() && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
